<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800"> <!-- clean white background = the slight white space around the circle --> <rect width="800" height="800" fill="#FFFFFF"/> <!-- navy circle --> <circle cx="400" cy="400" r="340" fill="#0D2D4F"/> <!-- thin white inset ring --> <circle cx="400" cy="400" r="298" fill="none" stroke="#FFFFFF" stroke-width="16"/> <!-- bold white H --> <g fill="#FFFFFF"> <rect x="272" y="240" width="72" height="320"/> <rect x="456" y="240" width="72" height="320"/> <rect x="272" y="364" width="256" height="72"/> </g> </svg>
